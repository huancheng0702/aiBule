<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_radius_9_white"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="15dp"
            android:textColor="#020404"
            android:textSize="22sp"
            tools:text="没有结果！" />


        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="60dp"
            android:gravity="center_horizontal">

            <EditText
                android:id="@+id/et_filterName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edit_input_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="输入要过滤的设备名称"
                android:maxLength="20"
                android:textColor="@color/black"
                android:textSize="15dp" />
        </LinearLayout>

        <View style="@style/LineHorizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_left_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16sp"
                tools:text="取消" />

            <View style="@style/LineVertical"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tv_right_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#00E173"
                android:textSize="16sp"
                tools:text="确定" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
