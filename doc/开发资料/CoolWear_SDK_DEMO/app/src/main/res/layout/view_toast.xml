        android:gravity="center"
        android:paddingLeft="26dp"
        android:paddingRight="26dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_14"
        tools:text="xxxxxxxxxxxxxx" />

</RelativeLayout>