<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/def_height"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="工具列表"
            android:textColor="#333333"
            android:textSize="21sp" />

        <ImageView
            android:id="@+id/ivSetting"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_gravity="end"
            android:layout_marginEnd="20dp"
            android:src="@mipmap/icon_setting" />
    </RelativeLayout>

    <TextView
        android:id="@+id/btn_ring_test"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:background="@mipmap/ic_home_bg1"
        android:gravity="center"
        android:text="戒指产测工具"
        android:textColor="@color/grey_333"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_dev_test"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@mipmap/ic_home_bg2"
        android:gravity="center"
        android:text="设备测试"
        android:textColor="@color/grey_333"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_light_leakage_test"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@mipmap/ic_home_bg3"
        android:gravity="center"
        android:text="漏光测试"
        android:textColor="@color/grey_333"
        android:textSize="18sp"
        android:visibility="visible" />


    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:text="版本号："
        android:textColor="@color/black"
        android:textSize="20sp" />
</LinearLayout>