<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.coolwear.bluesdk">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />

    <application
        android:name="com.coolwear.bluesdk.MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/logo_sdk"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/logo_sdk"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar">
        <!--        兼容拍照-->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ydFileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ydsharefile" />
        </provider>


        <!--        &lt;!&ndash;工具采集入口&ndash;&gt;-->
        <activity
            android:name="com.coolwear.bluesdk.activity.ScanningActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--数据采集入口-->
        <activity
            android:name="com.coolwear.bluesdk.activity.DataCollectionActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD">
            <!--            <intent-filter>-->
            <!--                <action android:name="android.intent.action.MAIN" />-->
            <!--                <category android:name="android.intent.category.LAUNCHER" />-->
            <!--            </intent-filter>-->
        </activity>

        <activity
            android:name="com.coolwear.bluesdk.activity.MainActivity"
            android:exported="false"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|orientation|screenLayout|uiMode|screenSize|navigation"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />

        <activity
            android:name="com.coolwear.bluesdk.activity.SettingActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD"></activity>

        <provider
            android:name="ce.com.cenewbluesdk.BleContentProvider.YDBleContentProvider"
            android:authorities="${applicationId}"
            android:exported="true"
            android:protectionLevel="signature" />
        <service
            android:name="ce.com.cenewbluesdk.pushmessage.NtfCollector"
            android:exported="false"
            android:label="sdkpush"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:persistent="true"
            android:priority="1000">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name="com.coolwear.bluesdk.activity.SDKPushSettingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />
        <activity
            android:name="com.coolwear.bluesdk.activity.ModifyDialActivity"
            android:exported="false"
            android:label="Modify dial"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />
        <activity
            android:name="com.coolwear.bluesdk.activity.DeveloperToolActivity"
            android:exported="false"
            android:label="Dial development tools"

            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />

        <activity
            android:name="com.coolwear.bluesdk.activity.ImportFileActivity"
            android:exported="true"
            android:theme="@style/Theme.CoolWearSKD"
            tools:ignore="AppLinkUrlError">
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <action android:name="android.intent.action.VIEW" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.coolwear.bluesdk.activity.ReceiveDataActivity"
            android:exported="false"
            android:label="Receive bluetooth data"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />
        <activity
            android:name="com.coolwear.bluesdk.activity.GsensorActivity"
            android:exported="false"
            android:label="Gsensor data"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />
        <activity
            android:name="com.coolwear.bluesdk.activity.OTAUpgradeActivity"
            android:exported="false"
            android:label="OTA Upgrade"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />
        <activity
            android:name="com.coolwear.bluesdk.activity.UpgradeOtaActivity"
            android:exported="false"
            android:label="OTA Upgrade"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/windowNoActionBar" />
        <activity
            android:name=".activity.ContactsActivity"
            android:exported="false"
            android:label="Contacts"
            android:screenOrientation="portrait"
            android:theme="@style/windowNoActionBar" />

        <service
            android:name="org.eclipse.paho.android.service.MqttService"
            android:enabled="true"
            android:exported="true"
            android:process=":yuedong" />
        <activity
            android:name="com.coolwear.bluesdk.activity.DataCollectionDetailsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />

        <service android:name=".tcp.TcpClientService"></service>

        <activity
            android:name="com.coolwear.bluesdk.activity.SleepMonitorActivity"
            android:exported="false"
            android:label="导睡眠数据"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoolWearSKD" />
    </application>

</manifest>